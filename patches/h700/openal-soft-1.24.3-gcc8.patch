# nextui-mkxp H700-specific patch for OpenAL Soft 1.24.3 (mkxp-z wrap), not upstream.
# The pinned NextUI cross compiler is GCC 8.3 (glibc 2.28 compatibility), which rejects
# throw/logging calls inside constexpr functions and lacks std::reduce. The 12 enum-mapping
# helpers are only called at run time, so constexpr -> inline keeps behaviour; std::reduce
# over a small float array becomes the sequential std::accumulate. GCC 8 also keeps
# std::filesystem in libstdc++fs, so the overlay's openal_dep links it when present.
# License: OpenAL Soft LGPL-2.1-or-later.

--- a/al/auxeffectslot.cpp
+++ b/al/auxeffectslot.cpp
@@ -220,7 +220,7 @@
 
 
 [[nodiscard]]
-constexpr auto EffectSlotTypeFromEnum(ALenum type) noexcept -> EffectSlotType
+inline auto EffectSlotTypeFromEnum(ALenum type) noexcept -> EffectSlotType
 {
     switch(type)
     {
