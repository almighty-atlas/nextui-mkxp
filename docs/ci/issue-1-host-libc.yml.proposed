# Proposed only: activate at .github/workflows/issue-1-host-libc.yml after rights review.
name: Issue 1 offline host libc inspection
on:
  push:
    paths:
      - tools/inspect_h700_libc.py
      - tests/test_h700_host_libc.py
      - docs/H700_HOST_LIBC.md
      - docs/COMPATIBILITY.md
      - .github/workflows/issue-1-host-libc.yml
  pull_request:
    paths:
      - tools/inspect_h700_libc.py
      - tests/test_h700_host_libc.py
      - docs/H700_HOST_LIBC.md
      - docs/COMPATIBILITY.md
      - .github/workflows/issue-1-host-libc.yml
permissions:
  contents: read
jobs:
  offline:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Synthetic host tests only (no stock libraries)
        run: python3 -I -B -m unittest discover -s tests -p test_h700_host_libc.py -v
      - name: Check complete branch whitespace
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.before }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          if [ "$BASE_SHA" = 0000000000000000000000000000000000000000 ]; then
            BASE_SHA=$(git merge-base origin/main "$HEAD_SHA")
          fi
          git diff --check "$BASE_SHA" "$HEAD_SHA"
